{
  "name": "saan-website",
  "version": "1.0.0",
  "private": true,
  "description": "SAAN Protocol Experts Private Limited corporate website",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-windows-export.mjs && node scripts/optimize-images.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "wrangler": "4.157.0"
  }
