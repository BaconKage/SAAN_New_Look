# =============================================================================
# SAAN website — environment template
#
# Copy to `.env.local` and fill in. NEVER commit real values.
# `.env.local` is gitignored.
#
# The application MUST build and run with only the "Site" block set. Every
# other block is optional until the feature that needs it is built.
# =============================================================================

# --- Site ---------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | staging | production
# Anything other than `production` emits `Disallow: /` in robots.txt and an
# `X-Robots-Tag: noindex` header.
NEXT_PUBLIC_SITE_ENV=development

# Development audit mode.
#
# `true` renders visible [CONTENT REQUIRED] markers on the pages so the team can
# see exactly what is still missing while reviewing. MUST remain false for any
# preview or production build — visitors never see scaffolding, and missing
# optional fields are omitted gracefully instead.
#
# Outstanding items are tracked by `npm run audit:content`, and
# `npm run validate:launch` fails while launch-critical fields are unresolved.
SHOW_CONTENT_TODOS=false


# --- CMS (Sanity) — Phase 4 ---------------------------------------------
# Absent values are fine: the site falls back to the local content source and
# builds without any CMS credentials.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=


# --- Transactional email — Phase 6 --------------------------------------
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=
#
# [CONTENT REQUIRED: Confirmed sales email]   — no address is published on the
# [CONTENT REQUIRED: Confirmed support email]   current site; both are unknown.
# ENQUIRY_TO_EMAIL=
# SUPPORT_TO_EMAIL=


# --- Spam protection and rate limiting — Phase 6 -------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# --- Analytics — Phase 8 -------------------------------------------------
# none | ga4 | plausible | umami
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# NEXT_PUBLIC_ANALYTICS_ID=
