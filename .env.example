# Copy to .env.local for local overrides. Never commit real values.
# Neither is needed on Cloudflare: a build of `main` there is production with
# https://saanpro.com, any other branch is a preview (see next.config.ts).

# Canonical origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | production
# Anything other than `production` sends a noindex robots meta tag and a Disallow robots.txt.
NEXT_PUBLIC_SITE_ENV=development
